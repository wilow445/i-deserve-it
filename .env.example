# Supabase — get these from project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECTID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Web Push — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BK...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:you@example.com

# Anthropic — for AI affirmation generation
ANTHROPIC_API_KEY=sk-ant-...

# Cron protection — generate any random string, e.g. openssl rand -hex 32
CRON_SECRET=...
